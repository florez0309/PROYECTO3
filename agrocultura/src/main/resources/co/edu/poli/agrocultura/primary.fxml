<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.agrocultura.PrimaryController">
    
    <!-- Top: Título y botón Serializar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2e7d32; -fx-padding: 10;">
            <Label text="🌱 AgroCultura - Gestión de Artículos" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📦 Serializar" onAction="#serializar" style="-fx-background-color: #ff9800; -fx-text-fill: white;"/>
        </HBox>
    </top>
    
    <!-- Left: Formulario de entrada -->
    <left>
        <VBox spacing="8" style="-fx-padding: 10; -fx-pref-width: 320; -fx-border-color: #ccc; -fx-border-width: 0 1 0 0;">
            <Label text="📝 Datos del Artículo" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            
            <!-- Tipo de artículo -->
            <Label text="Tipo de Artículo:"/>
            <ComboBox fx:id="comboTipoArticulo" onAction="#cambiarTipoArticulo" promptText="Seleccione tipo...">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Semilla"/>
                        <String fx:value="Composta"/>
                        <String fx:value="Nutriente"/>
                        <String fx:value="ControlPlaga"/>
                    </FXCollections>
                </items>
            </ComboBox>
            
            <!-- Campos comunes -->
            <Label text="Código:"/>
            <TextField fx:id="txtCodigo" promptText="Ej: 1001"/>
            <Label text="Descripción:"/>
            <TextField fx:id="txtDescripcion" promptText="Descripción del artículo"/>
            <Label text="Stock Disponible:"/>
            <TextField fx:id="txtStock" promptText="Ej: 50.5"/>
            <Label text="Fecha Registro (yyyy-mm-dd):"/>
            <TextField fx:id="txtFecha" promptText="Ej: 2024-01-15"/>
            
            <!-- Panel Semilla -->
            <VBox fx:id="panelSemilla" visible="false" managed="false" spacing="5" style="-fx-padding: 5; -fx-border-color: #4caf50; -fx-border-radius: 3;">
                <Label text="🌾 Datos de Semilla" style="-fx-font-weight: bold;"/>
                <Label text="Tipo de Semilla:"/>
                <TextField fx:id="txtTipoSemilla" promptText="Ej: rápido, medio, lento"/>
            </VBox>
            
            <!-- Panel Composta -->
            <VBox fx:id="panelComposta" visible="false" managed="false" spacing="5" style="-fx-padding: 5; -fx-border-color: #8bc34a; -fx-border-radius: 3;">
                <Label text="🍂 Datos de Composta" style="-fx-font-weight: bold;"/>
                <Label text="Fuente:"/>
                <TextField fx:id="txtFuente" promptText="Ej: orgánica, vegetal"/>
                <Label text="Tiempo Descomposición (días):"/>
                <TextField fx:id="txtTiempoDescomposicion" promptText="Ej: 90"/>
                <Label text="Tipo Unidad:"/>
                <TextField fx:id="txtUnidadComposta" promptText="Ej: kg, toneladas"/>
            </VBox>
            
            <!-- Panel Nutriente -->
            <VBox fx:id="panelNutriente" visible="false" managed="false" spacing="5" style="-fx-padding: 5; -fx-border-color: #2196f3; -fx-border-radius: 3;">
                <Label text="🧪 Datos de Nutriente" style="-fx-font-weight: bold;"/>
                <Label text="Composición:"/>
                <TextField fx:id="txtComposicion" promptText="Ej: NPK 10-10-10"/>
                <Label text="Tipo Unidad:"/>
                <TextField fx:id="txtUnidadNutriente" promptText="Ej: litros, kg"/>
            </VBox>
            
            <!-- Panel ControlPlaga -->
            <VBox fx:id="panelControlPlaga" visible="false" managed="false" spacing="5" style="-fx-padding: 5; -fx-border-color: #f44336; -fx-border-radius: 3;">
                <Label text="🐛 Datos de Control de Plaga" style="-fx-font-weight: bold;"/>
                <Label text="Plaga Objetivo:"/>
                <TextField fx:id="txtPlagaObjetivo" promptText="Ej: pulgones, hormigas"/>
                <Label text="Nivel Toxicidad:"/>
                <TextField fx:id="txtToxicidad" promptText="Ej: baja, media, alta"/>
                <Label text="Tipo Unidad:"/>
                <TextField fx:id="txtUnidadPlaga" promptText="Ej: ml, gramos"/>
            </VBox>
            
            <!-- Botones CRUD -->
            <Separator/>
            <HBox spacing="5">
                <Button text="➕ Crear" onAction="#crearArticulo" style="-fx-background-color: #4caf50; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                <Button text="✏️ Modificar" onAction="#modificarArticulo" style="-fx-background-color: #2196f3; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="5">
                <Button text="🗑️ Eliminar" onAction="#eliminarArticulo" style="-fx-background-color: #f44336; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Limpiar" onAction="#limpiarFormulario" style="-fx-background-color: #9e9e9e; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Leer por índice -->
            <Separator/>
            <Label text="🔍 Leer por Índice:"/>
            <HBox spacing="5">
                <TextField fx:id="txtIndiceLeer" promptText="Índice (0, 1...)" HBox.hgrow="ALWAYS"/>
                <Button text="Buscar" onAction="#leerPorIndice"/>
            </HBox>
            
            <!-- Mensaje de estado -->
            <Label fx:id="lblMensaje" wrapText="true" style="-fx-text-fill: #d32f2f; -fx-font-weight: bold;"/>
        </VBox>
    </left>
    
    <!-- Center: TableView -->
    <center>
        <TableView fx:id="tablaArticulos" style="-fx-padding: 10;">
            <columns>
                <TableColumn fx:id="colIndice" text="Índice" prefWidth="60"/>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="200"/>
                <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                <TableColumn fx:id="colDetalles" text="Detalles" prefWidth="250"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>
    
    <!-- Bottom: Estado -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10; -fx-background-color: #f5f5f5;">
            <Button text="🔄 Actualizar Tabla" onAction="#cargarTabla"/>
            <Label fx:id="lblContador" text="Artículos: 0"/>
        </HBox>
    </bottom>
    
</BorderPane>